{
  "private": false,
  "displayName": "Homebridge Moonraker Plugin",
  "name": "homebridge-moonraker",
  "version": "1.0.2",
  "description": "A Homebridge plugin that integrates with moonraker.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/rajivsarvepalli/homebridge-moonraker.git"
  },
  "bugs": {
    "url": "https://github.com/rajivsarvepalli/homebridge-moonraker/issues"
  },
  "engines": {
    "node": "^18.17.0 || ^20.9.0",
    "homebridge": "^1.6.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint src/**.ts --max-warnings=0",
    "watch": "npm run build && npm link && nodemon",
    "build": "rimraf ./dist && tsc",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "keywords": [
    "homebridge-plugin",
    "moonraker",
    "klipper",
    "3d printing",
    "smart 3d printing"
  ],
  "dependencies": {
    "axios": "^1.6.7",
    "moonraker-client": "^1.0.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^22.2.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.45.0",
    "homebridge": "^1.6.0",
    "nodemon": "^2.0.22",
    "rimraf": "^3.0.2",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.5"
  }
}
